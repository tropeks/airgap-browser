# Copie para .env (o docker compose lê sozinho) e ajuste. Nada aqui é obrigatório.
# O .env fica fora do git (.gitignore).

# --- Acesso -------------------------------------------------------------------
# Senha do QP (HTTP Basic). Vazia: o app não pede senha, então só deixe vazia com a
# porta presa em 127.0.0.1 ou com algo que autentique na frente (Cloudflare Access,
# reverse proxy com login). No docker-compose.prod.yml, o modo remoto usa a mesma senha.
SAFEBROWSE_AUTH_USER=qp
SAFEBROWSE_AUTH_PASSWORD=

# --- Portas -------------------------------------------------------------------
# docker-compose.yml (uso local): interface e porta do app.
QP_BIND=127.0.0.1
QP_PORT=8000
# docker-compose.prod.yml (servidor): sempre em 127.0.0.1; quem publica é o proxy da frente.
# Descomente e use outros valores se as portas padrão estiverem ocupadas.
# QP_PORT=18082
# QP_REMOTE_PORT=18085

# --- Modo remoto (docker-compose.prod.yml) ------------------------------------
# TZ=America/Sao_Paulo
# QP_REMOTE_LOCALE=pt_BR.UTF-8

# --- Ajustes do app (padrões no README, "Configuração") ----------------------
# Com docker compose, estas variáveis precisam também estar no bloco environment
# do serviço; rodando com `uv run uvicorn`, basta exportá-las.
# SAFEBROWSE_MAX_BYTES=5242880
# SAFEBROWSE_TIMEOUT=15
# SAFEBROWSE_RATE_LIMIT=120
# SAFEBROWSE_RENDER=1
